---
import Doc from "@/layouts/Doc.astro";
import Arrow from "@/components/Arrow.astro";

const cards = [
  {
    href: "/docs/quickstart",
    title: "Quickstart",
    body: "Deploy or run locally, call /api/runs, and inspect proof in minutes.",
  },
  {
    href: "/docs/demo",
    title: "Demo",
    body: "Run a public repo in a Cloudflare Container and inspect runner receipts, work receipts, and an artifact."
  },
  {
    href: "/docs/concepts",
    title: "Concepts",
    body: "Repo computers are the product center. Typed workspaces remain as a secondary evaluation surface.",
  },
  {
    href: "/docs/api",
    title: "API reference",
    body: "Repo-run, live-run, preview, and workspace endpoints with curl examples and response shapes.",
  },
  {
    href: "/docs/recipes",
    title: "Recipes",
    body: "Bring your agent, run proof from CI, steer live work, and use optional advanced surfaces."
  },
  {
    href: "/docs/architecture",
    title: "Architecture",
    body: "Worker control plane, Container runners, live-run snapshots, R2/D1/DO state, and authority boundaries."
  },
];
---

<Doc
  eyebrow="Documentation"
  title="Cloudbox docs"
  description="Cloudbox gives agents Cloudflare-native computers for real repo work: commands to execute, files to inspect, dev previews to steer, artifacts to return, and receipts to audit. These docs show the seven-minute path, the demo run, the core concepts, and the API."
>
  <h2>Pick your path</h2>
  <div class="grid gap-3 sm:grid-cols-2">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="group flex items-start justify-between gap-3 rounded-lg border border-kumo-line bg-kumo-base p-4 hover:bg-kumo-elevated"
        >
          <div class="min-w-0">
            <div class="font-semibold text-kumo-default">{card.title}</div>
            <div class="mt-1 text-sm leading-6 text-kumo-strong">
              {card.body}
            </div>
          </div>
          <Arrow size={16} />
        </a>
      ))
    }
  </div>

  <h2>Product center</h2>
  <p>
    Cloudbox should stay centered on runs. A run is a clean remote repo computer that returns receipts, diff, and an artifact. Live runs can stay open for file and command access, an optional secure dev preview such as a remote <code>bun run dev</code>, stop/resume/fork lifecycle, and the same reviewable proof trail when the run closes.
  </p>

  <h2>Status</h2>
  <p>
    Alpha. Repo runs, live steering, dev preview, stop/resume/fork, shareable proof pages, and TypeScript adapters are in the repo. Desktop/browser-shell sessions, durable owner computers, and typed workspaces are advanced or evaluation surfaces. Source on <a href="https://github.com/acoyfellow/cloudbox">GitHub</a>.
  </p>
</Doc>
